{
  "name": "@minhduydev/pi-todo",
  "version": "0.4.0",
  "description": "Durable markdown todo manager for Pi Coding Agent \u2014 structured TODO.md phases, a `todo` tool + `/todo` command, optional TUI widget, and single-active-task invariants.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "import": "./dist/replay.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/*.test.ts",
    "prepublishOnly": "npm run check",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "todo",
    "tasks",
    "extension",
    "productivity",
    "markdown",
    "subagents",
    "durable"
  ],
  "license": "MIT",
  "author": "minhduydev <minhduy.dev@gmail.com>",
  "homepage": "https://github.com/minhduydev/pi-todo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhduydev/pi-todo.git"
  },
  "bugs": {
    "url": "https://github.com/minhduydev/pi-todo/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "replayPort": "./replay"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.81.1 <0.82.0",
    "@earendil-works/pi-tui": ">=0.81.1 <0.82.0",
    "typebox": "1.1.38",
    "@minhduydev/pi-core": "^0.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@earendil-works/pi-tui": "0.81.1",
    "@minhduydev/pi-core": "file:../pi-core",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.0.0",
    "typebox": "1.1.38",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  }
}
